  "areaSelector": ".video-area",
  "langSelector": ".video-lang",
  "statusSelector": ".video-status",
  "pattern": {
    "title": "{title}",
    "url": "{url}",
    "id": "{id}"
  },
  "filter": {
    "year": "",
    "area": "",
    "lang": "",
    "limit": 20
  }
}